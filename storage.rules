rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // الملفات المشارَكة داخل الجلسات المباشرة (PDF / صور)
    match /meeting_files/{channel}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 30 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    // أعمال المفهمين: الرفع لصاحب الحساب فقط، والقراءة للجميع
    match /portfolio/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid && request.resource.size < 500 * 1024 * 1024;
    }

    // صور البروفايل قيد المراجعة: يرفعها صاحب الحساب، وتنتقل للمسار العام بعد موافقة الإدارة
    match /pending/profiles/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && fileName.matches(request.auth.uid + '_.*[.]jpg')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Lesson videos: nobody can read these directly through the normal
    // Storage SDK/URLs — not even a signed-in user. The ONLY way to get
    // a playable URL is through the getSignedVideoUrl Cloud Function,
    // which uses the Admin SDK (which bypasses these rules entirely) to
    // mint a short-lived signed URL after verifying purchase.
    match /courses/{courseId}/lessons/{fileName} {
      allow read: if false;
      allow write: if false; // uploaded only via the admin dashboard / Admin SDK
    }

    // Public assets (course thumbnails, instructor photos, app logo)
    // can stay openly readable.
    match /public/profiles/{userId}.jpg {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
